# HackAgon server configuration.
# Copy to .env and fill in. .env is gitignored — never commit real secrets.

PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=hackagon
# Set true when your managed MySQL service requires TLS.
DB_SSL=false
# Legacy local name; DB_PASSWORD takes precedence.
DB_PASS=

# --- Sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Groq (AI coach) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gmail SMTP (app password, not your normal password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=HACK AGON

# Set to false once EMAIL_* above are real: stops the API from echoing OTP codes.
EXPOSE_OTP_IN_RESPONSE=true

# Addresses that get the admin role automatically when they sign up.
ADMIN_EMAILS=
